{
  "id": "com.bilo.app",
  "name": "bilo - Developer Project Manager",
  "short_name": "bilo",
  "description": "Minimalist developer project management and task focus app",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "any",
  "background_color": "#090d16",
  "theme_color": "#06b6d4",
  "categories": ["productivity", "developer", "utilities"],
  "icons": [
    {
      "src": "/bilo-icon-light.png",
      "sizes": "1024x1024 512x512 192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/bilo-icon-light.png",
      "sizes": "512x512 192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    }
  ],
  "shortcuts": [
    {
      "name": "Today Focus",
      "url": "/",
      "icons": [{ "src": "/bilo-icon-light.png", "sizes": "192x192" }]
    },
    {
      "name": "Kanban Board",
      "url": "/",
      "icons": [{ "src": "/bilo-icon-light.png", "sizes": "192x192" }]
    }
  ]
}